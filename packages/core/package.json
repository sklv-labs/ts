{
  "name": "@sklv-labs/core",
  "version": "0.1.0",
  "description": "Core TypeScript package for sklv-labs",
  "author": "sklv-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklv-labs/ts.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "import": "./dist/enums/index.js",
      "require": "./dist/enums/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./environment": {
      "types": "./dist/environment/index.d.ts",
      "import": "./dist/environment/index.js",
      "require": "./dist/environment/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.ts"
      ],
      "enums": [
        "./dist/enums/index.d.ts"
      ],
      "utils": [
        "./dist/utils/index.d.ts"
      ],
      "environment": [
        "./dist/environment/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@sklv-labs/dev-configs": "workspace:*"
  }
}
