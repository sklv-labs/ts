{
  "name": "@sklv-labs/core",
  "version": "0.1.0",
  "type": "commonjs",
  "description": "Core TypeScript package for sklv-labs",
  "author": "sklv-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklv-labs/ts.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "default": "./dist/enums/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./environment": {
      "types": "./dist/environment/index.d.ts",
      "default": "./dist/environment/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@sklv-labs/dev-configs": "workspace:*"
  }
}
