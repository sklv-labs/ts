{
  "name": "@sklv-labs/nestjs-config",
  "version": "0.2.1",
  "type": "commonjs",
  "description": "NestJS config package",
  "author": "sklv-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklv-labs/ts.git",
    "directory": "packages/nestjs-config"
  },
  "publishConfig": {
