{
  "name": "@sklv-labs/dev-configs",
  "version": "0.2.1",
  "type": "commonjs",
  "description": "Shared TypeScript, oxlint, Prettier and commitlint configuration for sklv-labs projects",
  "keywords": [
    "typescript",
    "oxlint",
    "prettier",
    "commitlint",
    "config",
    "preset",
    "nestjs"
  ],
  "author": "sklv-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklv-labs/ts.git",
    "directory": "packages/dev-configs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./oxlint/base.json": "./oxlint/base.json",
    "./oxlint/nestjs.json": "./oxlint/nestjs.json",
    "./prettier": "./prettier.js",
    "./commitlint": "./commitlint.js",
    "./lint-staged": "./lint-staged.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nestjs.json": "./tsconfig/nestjs.json"
  },
  "files": [
    "tsconfig",
    "oxlint",
    "prettier.js",
    "commitlint.js",
    "lint-staged.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@commitlint/config-conventional": "^21.0.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.0",
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@commitlint/config-conventional": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
