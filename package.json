{
  "name": "sklv-labs",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the @sklv-labs TypeScript packages",
  "author": "sklv-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklv-labs/ts.git"
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@sklv-labs/dev-configs": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.4.1",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
