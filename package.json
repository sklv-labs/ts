{
  "name": "sklv-labs",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the @sklv-labs TypeScript packages",
  "author": "sklv-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sklv-labs/ts.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@sklv-labs/dev-configs": "workspace:*",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "typescript-editor": "npm:typescript@^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
